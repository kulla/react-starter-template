{
  "name": "react-spa-starter-template",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.html --outdir dist",
    "check": "bun run check:tsc && bun run test:unit && bun run check:format && bun run check:lint",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint",
    "check:tsc": "tsc --noEmit",
    "fix": "bun run fix:lint && bun run fix:format && bun run check",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "dev": "bun --hot src/index.html",
    "preview": "bun run build && bun dist/index.html",
    "test:unit": "bun test"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tsconfig/bun": "^1.0.11",
    "@types/bun": "^1.4.2",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  }
}
